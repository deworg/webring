{
	"name": "@deworg/webring-manager",
	"version": "1.0.0",
	"description": "Manage a webring on your WordPress site.",
	"author": "Bernhard Kau",
	"license": "GPL-3.0-or-later",
	"keywords": [
		"wordpress",
		"webring",
		"block-editor",
		"gutenberg",
		"plugin",
		"fediverse",
		"open web",
		"blogroll"
	],
	"homepage": "https://github.com/deworg/webring-manager",
	"repository": {
		"type": "git",
		"url": "https://github.com/deworg/webring-manager.git"
	},
	"bugs": {
		"url": "https://github.com/deworg/webring-manager/issues"
	},
	"main": "build/index.js",
	"dependencies": {
		"prismjs": "^1.30.0"
	},
	"devDependencies": {
		"@wordpress/element": "^6.43.0",
		"@wordpress/icons": "^11.7.0",
		"@wordpress/scripts": "^31.4.0",
		"postcss-prefix-selector": "^2.1.1"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php --blocks-manifest",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"format:js": "wp-scripts format-js ./src",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss'",
		"lint:js": "wp-scripts lint-js ./src",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:md:js": "wp-scripts lint-md-js",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"make-json": "wp i18n make-json languages/ --no-purge",
		"make-pot": "wp i18n make-pot . languages/webring-manager.pot --exclude=vendor,node_modules,src",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"postpackages-update": "npm run build",
		"start": "wp-scripts start --webpack-copy-php --blocks-manifest",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js"
	}
}
